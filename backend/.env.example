# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# NEVER put real secrets in this .env.example file.

# ---- General ----
APP_NAME="AI School Management Platform"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api

# ---- Database ----
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@postgres:5432/ai_school_dashboard

# ---- Security / Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER_NAME="AI School Dashboard"

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Lockout / rate limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
LOGIN_RATE_LIMIT=10/minute
GLOBAL_RATE_LIMIT=100/minute

# ---- CORS ----
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ORIGINS=https://dashboard.rawadaltarh.com

# ---- File storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/attachments
MAX_UPLOAD_SIZE_MB=15
ALLOWED_ATTACHMENT_TYPES=application/pdf,image/png,image/jpeg,image/webp

# S3-compatible storage (future - not yet implemented)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---- Notifications / Email (future) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ---- Currency ----
DEFAULT_CURRENCY=SAR

# ---- Seed script (scripts/seed_initial_data.py) ----
# Only used when running the seed script manually. Never leave these set
# in a running production .env longer than needed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME="System Administrator"

# ---- PostgreSQL container settings (docker-compose.yml reads these) ----
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_school_dashboard
