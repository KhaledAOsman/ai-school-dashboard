# Used by docker-compose.yml itself (Postgres credentials).
# The backend's own .env (backend/.env) is separate and more detailed -
# see backend/.env.example.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_school_dashboard

# Redis (cache + shared rate-limit counters). Required - generate with:
#   openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# ---- Snapchat lead forms -> CRM (webhook) ----
# Webhook URL to register with Snap:
#   https://dashboard.rawadaltarh.com/api/integrations/snap/webhook/<SNAP_WEBHOOK_TOKEN>
# Generate the token with: openssl rand -hex 24   (empty = webhook disabled)
SNAP_WEBHOOK_TOKEN=
# hmacSecret returned by Snap when the webhook integration is created (optional)
SNAP_WEBHOOK_HMAC_SECRET=
# owner of auto-created leads (default: oldest active user) / default assignee (default: none)
SNAP_LEADS_SYSTEM_USER_EMAIL=
SNAP_LEADS_DEFAULT_ASSIGNEE_EMAIL=

# ---- CRM progress -> Snap Conversions API (offline events) ----
SNAP_CAPI_ENABLED=false
# Pixel used by the lead campaigns (Snap Events Manager)
SNAP_PIXEL_ID=014b4ba3-bc09-4b06-b65f-9a9eaaafdb37
# Conversions API token (Events Manager -> pixel -> Conversions API)
SNAP_CAPI_TOKEN=
# Snap event per CRM stage (empty = don't send that stage)
SNAP_EVENT_BOOKED=RESERVE
SNAP_EVENT_ATTENDED=START_TRIAL
SNAP_EVENT_PURCHASE=PURCHASE
SNAP_CAPI_SEND_LEAD_ID=true

# ---- CRM progress -> Meta Conversions API (CRM lead events) ----
META_CAPI_ENABLED=false
# dataset / pixel of the Edu-AISchool ad account (Events Manager)
META_PIXEL_ID=1978401076376348
# Events Manager -> dataset -> Settings -> Conversions API -> Generate access token
META_CAPI_TOKEN=
# Events Manager -> Test events (only used by the test-event endpoint)
META_TEST_EVENT_CODE=
META_EVENT_BOOKED=Schedule
META_EVENT_ATTENDED=StartTrial
META_EVENT_PURCHASE=Purchase

# ---- CRM progress -> TikTok Events API ----
TIKTOK_EVENTS_ENABLED=false
# web = pixel code (default) | crm / offline = event set id from Events Manager
TIKTOK_EVENT_SOURCE=web
TIKTOK_EVENT_SOURCE_ID=D8KNFA3C77UA4F3IOSFG
# Events Manager -> pixel -> Settings -> Events API -> Generate access token
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
TIKTOK_EVENT_BOOKED=Schedule
TIKTOK_EVENT_ATTENDED=StartTrial
TIKTOK_EVENT_PURCHASE=CompletePayment
